# Margins365 — production secrets (never commit real values)
# Copy to .env.local for Vite; set the same keys on DigitalOcean App Platform.

# Brand (K58) — canonical public host is margins365.com
VITE_PRODUCT_NAME=Margins365
VITE_PRODUCT_DOMAIN=margins365.com
VITE_TARGET_PRODUCT_DOMAIN=margins365.com

# Payments — Stripe subscriptions (v19 tiers)
VITE_PAYMENTS_MODE=stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2025-03-31.basil
STRIPE_TRIAL_DAYS=14
# From: STRIPE_SECRET_KEY=sk_... node scripts/stripe-bootstrap-products.mjs
STRIPE_PRICE_STARTER_MONTH=price_...
STRIPE_PRICE_STARTER_YEAR=price_...
STRIPE_PRICE_GROWTH_MONTH=price_...
STRIPE_PRICE_GROWTH_YEAR=price_...
STRIPE_PRICE_PRO_MONTH=price_...
STRIPE_PRICE_PRO_YEAR=price_...
STRIPE_PRICE_SCALE_MONTH=price_...
STRIPE_PRICE_SCALE_YEAR=price_...
# Legacy lifetime (optional; not used for new checkouts)
# STRIPE_PRICE_EARLY_BIRD=price_...
# STRIPE_PRICE_FULL=price_...

# Auth — Amazon SES (K5) + Google (K6/K57)
# K73 — SES From must be a verified margins365.com identity (SPF/DKIM/DMARC).
VITE_AUTH_MODE=strict
APP_ORIGIN=https://margins365.com
SES_FROM_ADDRESS=noreply@margins365.com
SES_FROM_EMAIL=noreply@margins365.com
AWS_SES_REGION=eu-north-1
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# K72 founding coupons (create in Stripe; 50% × 6 months / 25% annual)
# STRIPE_COUPON_FOUNDING_MONTHLY=m365_founding_50_6mo
# STRIPE_COUPON_FOUNDING_ANNUAL=m365_founding_25_annual
# Public OAuth web client ID (safe in the browser). Required for Continue with Google.
VITE_GOOGLE_CLIENT_ID=869885026269-24b2bi94acusblu3tr01l3d0nuio7c4p.apps.googleusercontent.com

# Demo harness (Switch to Free / K11 simulators). Leave unset in production.
# VITE_DEMO_HARNESS=false
